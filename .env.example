# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# Names are validated by scripts/check-env.mjs (npm run build runs it first)
# and by src/lib/env.ts + src/lib/env.server.ts at runtime.
#
# Generate the secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- public (shipped to the browser) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one permanent production domain. Set once. The single QR code encodes
# exactly "<NEXT_PUBLIC_SITE_URL>/p/<slug>" and must never change afterwards.
NEXT_PUBLIC_SITE_URL=

# Optional: Cloudflare Turnstile site key (public half).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- server only (never exposed to the browser) ----------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, only used by the SQL/RLS test runner.
SUPABASE_DB_URL=

# The single owner account. Sign-up is disabled in Supabase; this is the
# server-side allow-list check on top of it.
OWNER_EMAIL=
# Optional comma-separated extra addresses allowed to sign in.
OWNER_EMAIL_ALIASES=

# Hashes the 8-digit access codes (HMAC-SHA256). Rotating it only invalidates
# outstanding codes; it does not change the QR code.
ACCESS_CODE_SECRET=

# Signs the owner and visitor session cookies.
SESSION_COOKIE_SECRET=

# Salt for the coarse IP hash stored in the access log.
IP_HASH_SECRET=

# AES-256-GCM keyring for sensitive fields (Aadhaar, PAN, account numbers).
# JSON object of keyId -> base64 32-byte key. Only the active key is used for
# new writes; older keys stay until a rotation completes (see SETUP.md).
FIELD_ENCRYPTION_KEYS={"k1":""}
FIELD_ENCRYPTION_ACTIVE_KEY=k1

# Optional: Turnstile secret (private half).
TURNSTILE_SECRET_KEY=

# Optional: transactional email for alerts and password resets.
# Without RESEND_API_KEY the app logs alerts to the server console instead.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# --- tuning (defaults shown; leave blank to use the default) ---------------
MAX_UPLOAD_MB=50
SHARE_LINK_TTL_MINUTES=1440
OWNER_SESSION_IDLE_MINUTES=30
OWNER_SESSION_ABSOLUTE_DAYS=7
