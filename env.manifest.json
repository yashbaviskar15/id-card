{
  "$comment": "Single source of truth for environment variable names. Consumed by scripts/check-env.mjs and asserted against src/lib/env.ts by tests/unit/env-manifest.test.ts. Never put a real value in this file.",
  "client": [
    { "name": "NEXT_PUBLIC_SUPABASE_URL", "required": true, "kind": "url" },
    { "name": "NEXT_PUBLIC_SUPABASE_ANON_KEY", "required": true, "minLength": 20 },
    { "name": "NEXT_PUBLIC_SITE_URL", "required": true, "kind": "url", "https": true, "noTrailingSlash": true },
    { "name": "NEXT_PUBLIC_TURNSTILE_SITE_KEY", "required": false }
  ],
  "server": [
    { "name": "SUPABASE_SERVICE_ROLE_KEY", "required": true, "minLength": 20 },
    { "name": "SUPABASE_DB_URL", "required": false },
    { "name": "OWNER_EMAIL", "required": true, "kind": "email" },
    { "name": "OWNER_EMAIL_ALIASES", "required": false },
    { "name": "ACCESS_CODE_SECRET", "required": true, "minLength": 32 },
    { "name": "SESSION_COOKIE_SECRET", "required": true, "minLength": 32 },
    { "name": "IP_HASH_SECRET", "required": true, "minLength": 32 },
    { "name": "FIELD_ENCRYPTION_KEYS", "required": true, "minLength": 20 },
    { "name": "FIELD_ENCRYPTION_ACTIVE_KEY", "required": true, "minLength": 1 },
    { "name": "TURNSTILE_SECRET_KEY", "required": false },
    { "name": "RESEND_API_KEY", "required": false },
    { "name": "ALERT_FROM_EMAIL", "required": false, "kind": "email" },
    { "name": "ALERT_TO_EMAIL", "required": false, "kind": "email" },
    { "name": "MAX_UPLOAD_MB", "required": false, "kind": "int", "default": "50" },
    { "name": "SHARE_LINK_TTL_MINUTES", "required": false, "kind": "int", "default": "1440" },
    { "name": "OWNER_SESSION_IDLE_MINUTES", "required": false, "kind": "int", "default": "30" },
    { "name": "OWNER_SESSION_ABSOLUTE_DAYS", "required": false, "kind": "int", "default": "7" },
    { "name": "ACCESS_SESSION_MINUTES", "required": false, "kind": "int", "default": "15" }
  ]
}
